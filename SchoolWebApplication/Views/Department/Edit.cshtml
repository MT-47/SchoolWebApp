@model Department

@{
    ViewBag.Title = "Edit Department";
}

<div class="container mt-5">

    <div class="card shadow-sm border-0 mx-auto" style="max-width: 600px;">

        <div class="card-header bg-primary text-white fw-semibold">
            Edit Department
        </div>

        <div class="card-body p-4">

            <form method="post">

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Capacity" class="form-label fw-semibold"></label>
                    <input asp-for="Capacity" class="form-control" />
                    <span asp-validation-for="Capacity" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit" class="btn btn-primary px-4">
                        Update
                    </button>

                    <a asp-controller="Department"
                           asp-action="Index"
                           class="btn btn-outline-secondary px-4">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}