@model Student

@{
    ViewBag.Title = "Edit Student";

    SelectList deptsl = new SelectList(
        ViewBag.Departments,
        "DeptId",
        "Name"
    );
}

<div class="container mt-5">

    <div class="card shadow-sm border-0 mx-auto" style="max-width: 700px;">

        <div class="card-header bg-primary text-white fw-semibold">
            Edit Student
        </div>

        <div class="card-body p-4">

            <form method="post">

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold">
                        Name
                    </label>

                    <input asp-for="Name" class="form-control" />

                    <span asp-validation-for="Name"
                          class="text-danger small">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Age" class="form-label fw-semibold">
                        Age
                    </label>

                    <input asp-for="Age" class="form-control" />

                    <span asp-validation-for="Age"
                          class="text-danger small">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold">
                        Email
                    </label>

                    <input asp-for="Email" class="form-control" />

                    <span asp-validation-for="Email"
                          class="text-danger small">
                    </span>
                </div>

                <div class="mb-4">
                    <label asp-for="DeptNo" class="form-label fw-semibold">
                        Department
                    </label>

                    <select asp-for="DeptNo"
                            class="form-select"
                            asp-items="deptsl">

                        <option value="">-- Select Department --</option>

                    </select>

                    <span asp-validation-for="DeptNo"
                          class="text-danger small">
                    </span>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary px-4">
                        Update
                    </button>

                    <a asp-controller="Student"
                           asp-action="Index"
                           class="btn btn-outline-secondary px-4">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}